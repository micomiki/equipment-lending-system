+    with TestClient(eq_main.app) as eq, TestClient(loan_main.app) as loans:
+        def check_equipment(equipment_id):
+            response = eq.get(f"/equipment/{equipment_id}")
+            return response.json() if response.status_code == 200 else None
+
+        def acquire(equipment_id):
+            response = eq.post(f"/equipment/{equipment_id}/loan-guards")
+            if response.status_code != 201:
+                from fastapi import HTTPException
+                raise HTTPException(response.status_code, response.json()["detail"])
+            return response.json()["token"]
+
+        def release(equipment_id, token):
+            response = eq.post(
+                f"/equipment/{equipment_id}/loan-guards/release",
+                json={"token": token},
+            )
+            assert response.status_code == 200
+
+        monkeypatch.setattr(loan_main, "get_equipment", check_equipment)
+        monkeypatch.setattr(loan_main, "_acquire_guard", acquire)
+        monkeypatch.setattr(loan_main, "_release_guard", release)
+        monkeypatch.setattr(
+            eq_main,
+            "_has_active_loans",
+            lambda equipment_id: loans.get(
+                f"/loans/active/equipment/{equipment_id}"
+            ).json()["has_active_loans"],
+        )
+        yield eq, loans
