+# All loan writes must acquire a durable guard before touching the Loan DB.
+# A deletion holds the Equipment DB write lock while checking the Loan Service.
+# This avoids the check-then-delete race across independent databases.
+class LoanGuardRelease(BaseModel):
+    token: str
+
+
+@app.post("/equipment/{equipment_id}/loan-guards", status_code=201)
+def acquire_loan_guard(equipment_id: int):
+    token = token_urlsafe(32)
+    with db() as conn:
+        conn.execute("BEGIN IMMEDIATE")
+        if not conn.execute(
+            "SELECT 1 FROM equipment WHERE id=?", (equipment_id,)
+        ).fetchone():
+            raise HTTPException(status_code=404, detail="Equipment not found")
+        conn.execute(
+            "INSERT INTO loan_guards(token, equipment_id) VALUES (?, ?)",
+            (token, equipment_id),
+        )
+    return {"token": token}
+
+
+@app.post("/equipment/{equipment_id}/loan-guards/release")
+def release_loan_guard(equipment_id: int, body: LoanGuardRelease):
+    with db() as conn:
+        conn.execute(
+            "DELETE FROM loan_guards WHERE equipment_id=? AND token=?",
+            (equipment_id, body.token),
+        )
+    return {"released": True}
+
+
+def _has_active_loans(equipment_id: int):
+    base_url = os.getenv("LOAN_SERVICE_URL", "http://127.0.0.1:8002")
+    try:
+        with httpx.Client(timeout=5.0) as client:
+            response = client.get(
+                f"{base_url}/loans/active/equipment/{equipment_id}"
+            )
+        response.raise_for_status()
+        return response.json()["has_active_loans"]
+    except httpx.RequestError as exc:
+        raise HTTPException(status_code=503, detail="Loan Service unavailable") from exc
+    except (httpx.HTTPStatusError, KeyError, ValueError) as exc:
+        raise HTTPException(status_code=502, detail="Loan Service error") from exc
+
+
+@app.delete("/equipment/{equipment_id}", status_code=204)
+def delete_equipment(equipment_id: int):
+    with db() as conn:
+        conn.execute("BEGIN IMMEDIATE")
+        if not conn.execute(
+            "SELECT 1 FROM equipment WHERE id=?", (equipment_id,)
+        ).fetchone():
+            raise HTTPException(status_code=404, detail="Equipment not found")
+        if conn.execute(
+            "SELECT 1 FROM loan_guards WHERE equipment_id=?", (equipment_id,)
+        ).fetchone():
+            raise HTTPException(
+                status_code=409, detail="A loan operation is in progress. Retry shortly."
+            )
+        if _has_active_loans(equipment_id):
+            raise HTTPException(
+                status_code=409,
+                detail="Cannot remove equipment with active loans. Cancel its loans first.",
+            )
+        conn.execute("DELETE FROM equipment WHERE id=?", (equipment_id,))
+    return None
