+def test_guards_prevent_deletion_and_loans_cannot_overlap(services):
+    eq, loans = services
+    item = eq.post("/equipment", json={"name": "Camera", "description": "4K"}).json()
+    equipment_id = item["id"]
+    payload = {
+        "equipment_id": equipment_id,
+        "start_date": "2026-12-01",
+        "end_date": "2026-12-05",
+    }
+    created = loans.post("/loans", json=payload)
+    assert created.status_code == 201
+    loan_id = created.json()["id"]
+
+    # Inclusive date endpoints conflict.
+    assert loans.post(
+        "/loans", json={**payload, "start_date": "2026-12-05"}
+    ).status_code == 409
+    assert eq.delete(f"/equipment/{equipment_id}").status_code == 409
+
+    assert loans.post(f"/loans/{loan_id}/cancel").status_code == 200
+    assert eq.delete(f"/equipment/{equipment_id}").status_code == 204
+    assert loans.post("/loans", json=payload).status_code == 404
+
+
+def test_unreleased_guard_blocks_deletion(services):
+    eq, loans = services
+    equipment_id = eq.post("/equipment", json={"name": "Monitor"}).json()["id"]
+    guard = eq.post(f"/equipment/{equipment_id}/loan-guards")
+    assert guard.status_code == 201
+    assert eq.delete(f"/equipment/{equipment_id}").status_code == 409
+    released = eq.post(
+        f"/equipment/{equipment_id}/loan-guards/release",
+        json={"token": guard.json()["token"]},
+    )
+    assert released.status_code == 200
+    assert eq.delete(f"/equipment/{equipment_id}").status_code == 204
+
