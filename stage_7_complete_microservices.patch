+"""HTTP gateway for browser views in microservice mode.
+
+The original SQLite API/CLI stays available as a local legacy mode.
+Browser views use this gateway when WEB_USE_MICROSERVICES=1.
+"""
+from datetime import date
+
+import httpx
+from fastapi import HTTPException
+
+from clients import equipment_client, loan_client
+
+
+def _call(fn, *args, **kwargs):
+    """Convert upstream failures to browser-friendly validation/503 errors."""
+    try:
+        return fn(*args, **kwargs)
+    except httpx.RequestError as exc:
+        raise HTTPException(status_code=503, detail="Microservice unavailable") from exc
+    except httpx.HTTPStatusError as exc:
+        status = exc.response.status_code
+        try:
+            detail = exc.response.json().get("detail", exc.response.text)
+        except (ValueError, AttributeError):
+            detail = exc.response.text
+        if isinstance(detail, list):
+            detail = "; ".join(str(item.get("msg", item)) for item in detail)
+        if status in {400, 404, 409, 422}:
+            raise ValueError(str(detail)) from exc
+        raise HTTPException(
+            status_code=503 if status == 503 else 502,
+            detail="Microservice returned an error",
+        ) from exc
+
+
+def equipment_items():
+    return _call(equipment_client.list_equipment)
+
+
+def equipment_items_by_name():
+    return sorted(equipment_items(), key=lambda item: (item["name"].casefold(), item["id"]))
+
+
+def equipment(equipment_id):
+    return _call(equipment_client.get_equipment, equipment_id)
+
+
+def add_equipment(name, description):
+    return _call(equipment_client.create_equipment, name, description)
+
+
+def update_equipment(equipment_id, name, description):
+    return _call(
+        equipment_client.update_equipment,
+        equipment_id,
+        name=name,
+        description=description,
+    )
+
+
+def delete_equipment(equipment_id):
+    return _call(equipment_client.delete_equipment, equipment_id)
+
+
+def loans_with_names():
+    items = _call(loan_client.list_loans)
+    names = {item["id"]: item["name"] for item in equipment_items()}
+    return sorted(
+        [
+            {
+                **loan,
+                "equipment_name": names.get(
+                    loan["equipment_id"],
+                    f"Equipment #{loan['equipment_id']} (removed)",
+                ),
+            }
+            for loan in items
+        ],
+        key=lambda loan: loan["id"],
+        reverse=True,
+    )
+
+
+def loan(loan_id):
+    result = _call(loan_client.get_loan, loan_id)
+    if result is None:
+        return None
+    item = equipment(result["equipment_id"])
+    return {
+        **result,
+        "equipment_name": item["name"] if item else f"Equipment #{result['equipment_id']} (removed)",
+    }
+
+
+def create_loan(equipment_id, start, end):
+    return _call(loan_client.create_loan, equipment_id, start, end)
+
+
+def change_loan(loan_id, start, end):
+    return _call(loan_client.update_loan, loan_id, start_date=start, end_date=end)
+
+
+def cancel_loan(loan_id):
+    return _call(loan_client.cancel_loan, loan_id)
+
+
+def search_equipment(start, end):
+    """Read-only cross-service availability snapshot (not a reservation)."""
+    try:
+        s, e = date.fromisoformat(start), date.fromisoformat(end)
+    except (TypeError, ValueError) as exc:
+        raise ValueError("Dates must use YYYY-MM-DD format.") from exc
+    if e < s:
+        raise ValueError("'to' date must be on or after 'from' date.")
+
+    items = equipment_items()
+    loans = _call(loan_client.list_loans)
+    unavailable = {
+        loan["equipment_id"]
+        for loan in loans
+        if loan["status"] == "active"
+        and loan["start_date"] <= end
+        and loan["end_date"] >= start
+    }
+    return [item for item in items if item["id"] not in unavailable]
